# ─── MRDU Environment Configuration ───────────────────────────
# Copy this file to .env and fill in your values

# Flask
SECRET_KEY=change-this-to-a-random-secret-key-in-production
FLASK_ENV=development

# Database (SQLite by default, change to PostgreSQL for production)
DATABASE_URL=sqlite:///mrdu.db
# DATABASE_URL=postgresql://user:password@localhost/mrdu_db

# ─── SMTP Email Configuration ───────────────────────────────────
# For Gmail: Enable 2FA → Generate App Password → use below
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_16_char_app_password

# For Outlook/Hotmail:
# MAIL_SERVER=smtp-mail.outlook.com
# MAIL_PORT=587

# For custom SMTP:
# MAIL_SERVER=mail.yourdomain.com
# MAIL_PORT=587
